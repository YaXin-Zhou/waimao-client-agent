# AI provider
AI_PROVIDER=deepseek
TAVILY_API_KEY=replace-with-your-tavily-api-key
SEARCH_TAVILY_ENABLED=true
SEARCH_TAVILY_TIMEOUT_SECONDS=20
SEARCH_TAVILY_RESULTS_PER_QUERY=20
SEARCH_TAVILY_QUERIES_PER_ROUND=8
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# Optional model escalation for complex review
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Network: leave empty when FlClash is transparent/system proxy mode
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Ali enterprise mailbox, read-only IMAP sync only. Never commit real credentials.
ALI_IMAP_HOST=imap.qiye.aliyun.com
ALI_IMAP_PORT=993
ALI_IMAP_USERNAME=
ALI_IMAP_PASSWORD=
ALI_IMAP_MAILBOX=INBOX

# SMTP remains disabled unless all fields are explicitly configured.
ALI_SMTP_HOST=smtp.qiye.aliyun.com
ALI_SMTP_PORT=465
ALI_SMTP_USERNAME=
ALI_SMTP_PASSWORD=
# Keep false by default. Set true only for a controlled, human-confirmed test.
ALI_SMTP_SENDING_ENABLED=false

# Runtime data paths
DATABASE_PATH=data/runtime/acquisition.db
EXPORT_DIRECTORY=data/exports
REPORT_DIRECTORY=docs/generated

# Local research queue governance
RESEARCH_QUEUE_WORKERS=2
RESEARCH_QUEUE_MAX_PENDING=100
RESEARCH_TIMEOUT_SECONDS=120
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_ENRICHMENT_TIMEOUT_SECONDS=45
# One bounded round per click; repeat later to accumulate leads.
# Low-frequency accumulation: 24 rounds x 20 minutes = 8 hours maximum.
# The queue stops immediately when the daily qualified target is reached.
DISCOVERY_MAX_SEARCH_ROUNDS=24
DISCOVERY_ROUND_INTERVAL_SECONDS=1200
SEARCH_GOOGLE_HOST=www.google.com.hk
# Optional HTTP proxy, for example http://127.0.0.1:7890. Empty means use
# Windows system proxy when enabled, otherwise connect directly.
SEARCH_PROXY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_RESULTS_PER_QUERY=10
SEARCH_PAGES_PER_QUERY=1
SEARCH_BROWSER_ENABLED=true
SEARCH_BROWSER_HEADLESS=true
SEARCH_BROWSER_EXECUTABLE=
SEARCH_BROWSER_PROXY=
SEARCH_BROWSER_TIMEOUT_SECONDS=30
# Avoid repeatedly hitting a temporarily blocked search source after failure.
SEARCH_FAILURE_COOLDOWN_SECONDS=300
# Experimental fallback; keep disabled until a real relevance sample is approved.
SEARCH_BING_ENABLED=true
SEARCH_BING_HOST=www.bing.com
# Optional official JSON search source. Keep the key only in config/.env.
SEARCH_BRAVE_API_ENABLED=false
BRAVE_SEARCH_API_KEY=
SEARCH_BRAVE_API_ENDPOINT=https://api.search.brave.com/res/v1/web/search
SEARCH_BRAVE_ENABLED=false
SEARCH_BRAVE_HOST=search.brave.com
SEARCH_DDG_ENABLED=true
SEARCH_DDG_HOST=html.duckduckgo.com
